#pragma once
#include "event.h"
#include <hdf5.h>
#include <string>
#include <vector>

class WriterH5 {
public:
    WriterH5(const std::string& filepath, const std::string& inputPath, hsize_t nEvents);
    ~WriterH5();

    // Écrit un chunk d'événements à partir de offset
    void writeChunk(const std::vector<Event>& events, hsize_t offset);

private:
    hid_t m_file;

    // Création des datasets pour un groupe (L ou H)
    void createFragmentDatasets(const std::string& grp, hsize_t nEvents);
    void writeFragmentChunk(const std::string& grp,
                            const std::vector<Event>& events,
                            bool isL, hsize_t offset);

    // Copie récursive de /metadata depuis le fichier d'entrée (H5Ocopy)
    void copyMetadata(const std::string& inputPath);
};
