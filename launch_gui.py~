#!/usr/bin/env python3
"""
Interface graphique pour configurer et lancer la simulation T2F.
À placer à la racine du projet (même niveau que simulation/).
"""

import tkinter as tk
from tkinter import ttk, scrolledtext
import subprocess
import threading
from pathlib import Path

# Chemins relatifs à la racine du projet
ROOT = Path(__file__).parent
CONFIG_FILE = ROOT / "simulation" / "config.txt"
BUILD_DIR   = ROOT / "simulation" / "build"
BINARY      = BUILD_DIR / "T2F"


def save_config(fields):
    lines = [
        f"sequential {'yes' if fields['sequential'].get() else 'no'}",
        f"parallel {fields['parallel'].get()}",
        f"events {fields['events'].get()}",
        f"elossmodel {fields['elossmodel'].get()}",
        f"elosstreat {fields['elosstreat'].get()}",
        f"pad {fields['pad'].get()}",
        f"pressure {fields['pressure'].get()}",
        f"skipgefline {fields['skipgefline'].get()}",
    ]
    CONFIG_FILE.write_text("\n".join(lines) + "\n")


def run_pipeline(fields, log):
    def append(msg):
        log.configure(state="normal")
        log.insert(tk.END, msg)
        log.see(tk.END)
        log.configure(state="disabled")

    # 1. Sauvegarde config
    save_config(fields)
    append("✓ config.txt sauvegardé\n")

    # 2. Compilation
    append("⟳ Compilation en cours...\n")
    result = subprocess.run(
        ["cmake", "--build", str(BUILD_DIR)],
        capture_output=True, text=True
    )
    if result.returncode != 0:
        append(f"✗ Erreur de compilation :\n{result.stderr}\n")
        return
    append("✓ Compilation réussie\n\n")

    # 3. Lancement avec sortie en temps réel
    append(f"▶ Lancement de {BINARY.name}...\n")
    proc = subprocess.Popen(
        [str(BINARY)],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, bufsize=1
    )
    for line in proc.stdout:
        append(line)
    proc.wait()
    if proc.returncode == 0:
        append("\n✓ Simulation terminée.\n")
    else:
        append(f"\n✗ Le programme s'est terminé avec le code {proc.returncode}.\n")


def launch(fields, log, btn_launch):
    btn_launch.configure(state="disabled")
    log.configure(state="normal")
    log.delete("1.0", tk.END)
    log.configure(state="disabled")
    t = threading.Thread(target=lambda: run_pipeline(fields, log), daemon=True)
    t.start()
    # Ré-active le bouton quand le thread est fini
    def wait():
        t.join()
        btn_launch.configure(state="normal")
    threading.Thread(target=wait, daemon=True).start()


def main():
    root = tk.Tk()
    root.title("T2F — Simulation")
    root.resizable(False, False)

    # ── Palette sobre, scientifique ──
    BG      = "#1e1e2e"
    PANEL   = "#2a2a3e"
    ACCENT  = "#7aa2f7"
    FG      = "#cdd6f4"
    FG_DIM  = "#6c7086"
    ENTRY   = "#313244"
    root.configure(bg=BG)

    style = ttk.Style()
    style.theme_use("clam")
    style.configure("TFrame",       background=BG)
    style.configure("TLabel",       background=BG,    foreground=FG,   font=("Menlo", 11))
    style.configure("TEntry",       fieldbackground=ENTRY, foreground=FG, font=("Menlo", 11))
    style.configure("TCombobox",    fieldbackground=ENTRY, foreground=FG, font=("Menlo", 11))
    style.configure("TCheckbutton", background=BG,    foreground=FG,   font=("Menlo", 11))
    style.map("TCombobox", fieldbackground=[("readonly", ENTRY)])

    # ── Titre ──
    title = tk.Label(root, text="T2F  ·  Simulation TPC",
                     bg=BG, fg=ACCENT, font=("Menlo", 14, "bold"))
    title.grid(row=0, column=0, columnspan=2, pady=(16, 10), padx=20, sticky="w")

    # ── Champs ──
    frame = ttk.Frame(root, padding=(20, 0, 20, 10))
    frame.grid(row=1, column=0, columnspan=2, sticky="ew")

    fields = {}

    def row(label, widget_factory, r):
        tk.Label(frame, text=label, bg=BG, fg=FG_DIM,
                 font=("Menlo", 10), anchor="e", width=14).grid(
            row=r, column=0, sticky="e", pady=4, padx=(0, 10))
        w = widget_factory(frame)
        w.grid(row=r, column=1, sticky="ew", pady=4)
        return w

    # sequential (checkbox)
    seq_var = tk.BooleanVar(value=False)
    fields["sequential"] = seq_var
    tk.Label(frame, text="sequential", bg=BG, fg=FG_DIM,
             font=("Menlo", 10), anchor="e", width=14).grid(
        row=0, column=0, sticky="e", pady=4, padx=(0, 10))
    ttk.Checkbutton(frame, variable=seq_var).grid(row=0, column=1, sticky="w", pady=4)

    # parallel
    par_var = tk.StringVar(value="14")
    fields["parallel"] = par_var
    row("parallel", lambda f: ttk.Entry(f, textvariable=par_var, width=10), 1)

    # events
    ev_var = tk.StringVar(value="1000000")
    fields["events"] = ev_var
    row("events", lambda f: ttk.Entry(f, textvariable=ev_var, width=12), 2)

    # elossmodel
    el_var = tk.StringVar(value="G4")
    fields["elossmodel"] = el_var
    def make_combo_el(f):
        c = ttk.Combobox(f, textvariable=el_var, values=["G4", "LG", "SRIM"],
                         state="readonly", width=8)
        return c
    row("elossmodel", make_combo_el, 3)

    # elosstreat
    et_var = tk.StringVar(value="svd")
    fields["elosstreat"] = et_var
    def make_combo_et(f):
        c = ttk.Combobox(f, textvariable=et_var, values=["native", "svd"],
                         state="readonly", width=8)
        return c
    row("elosstreat", make_combo_et, 4)

    # pad
    pad_var = tk.StringVar(value="2")
    fields["pad"] = pad_var
    row("pad (mm)", lambda f: ttk.Entry(f, textvariable=pad_var, width=8), 5)

    # pressure
    pres_var = tk.StringVar(value="300")
    fields["pressure"] = pres_var
    row("pressure (mbar)", lambda f: ttk.Entry(f, textvariable=pres_var, width=8), 6)

    # skipgefline
    skip_var = tk.StringVar(value="0")
    fields["skipgefline"] = skip_var
    row("skipgefline", lambda f: ttk.Entry(f, textvariable=skip_var, width=8), 7)

    frame.columnconfigure(1, weight=1)

    # ── Log ──
    sep = tk.Frame(root, bg=FG_DIM, height=1)
    sep.grid(row=2, column=0, columnspan=2, sticky="ew", padx=20, pady=(4, 8))

    log = scrolledtext.ScrolledText(
        root, width=72, height=18, state="disabled",
        bg=PANEL, fg=FG, font=("Menlo", 10),
        insertbackground=FG, relief="flat", bd=0
    )
    log.grid(row=3, column=0, columnspan=2, padx=20, pady=(0, 12), sticky="ew")

    # ── Boutons ──
    btn_frame = tk.Frame(root, bg=BG)
    btn_frame.grid(row=4, column=0, columnspan=2, padx=20, pady=(0, 16), sticky="e")

    btn_quit = tk.Button(btn_frame, text="Quitter", command=root.destroy,
                         bg=PANEL, fg=FG_DIM, font=("Menlo", 11),
                         relief="flat", padx=16, pady=6, cursor="hand2",
                         activebackground=ENTRY, activeforeground=FG)
    btn_quit.pack(side="left", padx=(0, 10))

    btn_launch = tk.Button(btn_frame, text="▶  Lancer",
                           bg=ACCENT, fg=BG, font=("Menlo", 11, "bold"),
                           relief="flat", padx=20, pady=6, cursor="hand2",
                           activebackground="#5a82d7", activeforeground=BG)
    btn_launch.configure(command=lambda: launch(fields, log, btn_launch))
    btn_launch.pack(side="left")

    root.mainloop()


if __name__ == "__main__":
    main()
